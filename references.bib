@article{jankowski_robust_2025,
	title = {Robust pushing: {Exploiting} quasi-static belief dynamics and contact-informed optimization},
	issn = {0278-3649, 1741-3176},
	shorttitle = {Robust pushing},
	url = {https://journals.sagepub.com/doi/10.1177/02783649251318046},
	doi = {10.1177/02783649251318046},
	abstract = {Non-prehensile manipulation such as pushing is typically subject to uncertain, non-smooth dynamics. However, modeling the uncertainty of the dynamics typically results in intractable belief dynamics, making data-efﬁcient planning under uncertainty difﬁcult. This article focuses on the problem of efﬁciently generating robust open-loop pushing plans. First, we investigate how the belief over object conﬁgurations propagates through quasi-static contact dynamics. We exploit the simpliﬁed dynamics to predict the variance of the object conﬁguration without sampling from a perturbation distribution. In a sampling-based trajectory optimization algorithm, the gain of the variance is constrained in order to enforce robustness of the plan. Second, we propose an informed trajectory sampling mechanism for drawing robot trajectories that are likely to make contact with the object. This sampling mechanism is shown to signiﬁcantly improve chances of ﬁnding robust solutions, especially when making-and-breaking contacts is required. We demonstrate that the proposed approach is able to synthesize bi-manual pushing trajectories, resulting in successful long-horizon pushing maneuvers without exteroceptive feedback such as vision or tactile feedback. We furthermore deploy the proposed approach in a model-predictive control scheme, demonstrating additional robustness against unmodeled perturbations.},
	language = {en},
	urldate = {2025-06-18},
	journal = {The International Journal of Robotics Research},
	author = {Jankowski, Julius and Brudermüller, Lara and Hawes, Nick and Calinon, Sylvain},
	month = feb,
	year = {2025},
	pages = {02783649251318046},
}

@inproceedings{hyland_onboard_2025,
	address = {Los Angeles, CA, USA},
	title = {Onboard {Sensing} and {Pushing} of {Unknown} {Payload} for {CoM} {Estimation} with a {Holonomic} {Mobile} {Robot}},
